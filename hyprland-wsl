#!/bin/bash
# hyprland-wsl: run Hyprland under WSL2 and show it in a window on the Windows desktop.
#
# WSL has no GPU device node that Hyprland can use, so this stacks:
#   vgem (virtual DRM device) -> labwc (headless host compositor, software GL)
#   -> Hyprland (nested, with the patched aquamarine from install.sh)
#   -> wayvnc (shares the host's screen) -> vncviewer (a normal WSLg window).
#
# Closing the viewer window (or Ctrl+C) shuts everything down.

usage() {
    cat <<'EOF'
Usage: hyprland-wsl [WIDTHxHEIGHT] [--scale N] [--port N] [--no-viewer]
       hyprland-wsl set-mod SUPER|ALT

  WIDTHxHEIGHT   size of the Hyprland screen (default 1600x900)
  --scale N      Hyprland's monitor scale, e.g. 2 for a 3840x2160 screen (default: from the config)
  --port N       VNC port on 127.0.0.1 (default 5900)
  --no-viewer    do not open a viewer window; connect any VNC client yourself

  set-mod        change the main modifier in the Hyprland config that install.sh wrote.
                 SUPER needs a viewer that captures the Windows key (see the README);
                 ALT works in every viewer.
EOF
}

case ${1:-} in -h|--help) usage; exit 0 ;; esac

[ "$(id -u)" = 0 ] || exec sudo -- "$0" "$@"

PREFIX=/opt/hyprland-wsl
AQ_LIB=$PREFIX/aquamarine/lib
CONF=/etc/hyprland-wsl.conf
LOG=/tmp/hyprland-wsl

RES=1600x900
PORT=5900
VIEWER=1
SCALE=
SETMOD=
while [ $# -gt 0 ]; do
    case $1 in
        --no-viewer) VIEWER=0 ;;
        --port) PORT=$2; shift ;;
        --scale) SCALE=$2; shift ;;
        set-mod) SETMOD=${2:-}; shift ;;
        [0-9]*x[0-9]*) RES=$1 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

die() { echo "hyprland-wsl: $*" >&2; exit 1; }

[ -f $CONF ] || die "$CONF not found; run install.sh first"
. $CONF
id "$HYPR_USER" >/dev/null 2>&1 || die "user '$HYPR_USER' from $CONF does not exist"

if [ -n "$SETMOD" ]; then
    case $SETMOD in SUPER|ALT) ;; *) die "set-mod takes SUPER or ALT" ;; esac
    cfg=$(getent passwd "$HYPR_USER" | cut -d: -f6)/.config/hypr
    if grep -qs '^local mainMod = "' "$cfg/hyprland.lua"; then
        sed -i "s/^local mainMod = \"[A-Z]*\".*/local mainMod = \"$SETMOD\"/" "$cfg/hyprland.lua"
    elif grep -qs '^\$mainMod = ' "$cfg/hyprland.conf"; then
        sed -i "s/^\\\$mainMod = .*/\$mainMod = $SETMOD/" "$cfg/hyprland.conf"
    else
        die "no main modifier line found in $cfg; change it in your config by hand"
    fi
    echo "Main modifier is now $SETMOD. It applies from the next start of hyprland-wsl."
    exit 0
fi

# The patched library has to match the aquamarine that Hyprland was built against.
built=$(cat $PREFIX/aquamarine/VERSION 2>/dev/null)
SYS_LIB=$(readlink -f "$(ldconfig -p | awk '/libaquamarine\.so\.[0-9]+ / { print $NF; exit }')")
installed=${SYS_LIB##*/libaquamarine.so.}
[ "$built" = "$installed" ] && [ -f "$AQ_LIB/${SYS_LIB##*/}" ] ||
    die "the patched aquamarine is for '$built' but '$installed' is installed; rerun install.sh"

U=$HYPR_USER
H=$(getent passwd "$U" | cut -d: -f6)
R=/run/user/$(id -u "$U")
pgrep -u "$U" -x Hyprland >/dev/null && die "Hyprland is already running for $U"

# A DRM device for buffer allocation. Dumb buffers are refused on render nodes,
# so the render node path is pointed at the primary node.
modprobe vgem || die "could not load the vgem kernel module"
card=
for c in /sys/class/drm/card[0-9]*; do
    case $(readlink -f "$c/device") in */vgem) card=$c ;; esac
done
[ -n "$card" ] || die "vgem DRM device not found"
render=$(ls "$card/device/drm" | grep '^renderD' | head -n 1)
IFS=: read -r major minor < "$card/dev"
rm -f "/dev/dri/$render"
mknod "/dev/dri/$render" c "$major" "$minor"
chmod 666 "/dev/dri/${card##*/}" "/dev/dri/$render"

mkdir -p $LOG "$R"
chown "$U": "$R" && chmod 700 "$R"
rm -rf "$R/hypr" "$R"/wayland-* "$R/wayvncctl"

# Terminals want a UTF-8 locale; fall back to the one glibc always has.
LANG=
for f in /etc/locale.conf /etc/default/locale; do
    [ -r $f ] && LANG=$(. $f; echo "${LANG:-}") && [ -n "$LANG" ] && break
done
case $LANG in *.[Uu][Tt][Ff]*8) ;; *) LANG=C.UTF-8 ;; esac

# TigerVNC's viewer is "vncviewer" on Arch and "xtigervncviewer" on Debian and Ubuntu.
VNCVIEWER=$(command -v xtigervncviewer || command -v vncviewer)

wait_for() { for _ in $(seq 150); do "$@" && return 0; sleep 0.1; done; return 1; }

cleanup() {
    trap - EXIT INT TERM
    pkill -u "$U" -x Hyprland; sleep 0.5
    pkill -u "$U" -x wayvnc; pkill -u "$U" -x labwc
    [ -n "$VNCVIEWER" ] && pkill -u "$U" -x "${VNCVIEWER##*/}"
    # Where libseat has its built-in backend, Hyprland leaves a helper process behind.
    pkill -9 -u "$U" -x Hyprland
    [ -n "${NS:-}" ] && kill "$NS" 2>/dev/null
}
trap cleanup EXIT INT TERM

# The compositors run in a private mount namespace, held open by a sleeping process, where:
# - the patched aquamarine sits on top of the system one. LD_LIBRARY_PATH would not do:
#   some distros give Hyprland a file capability, and the loader then ignores it.
# - /tmp/.X11-unix is a fresh directory. WSLg mounts its own there without the sticky bit,
#   which makes Xwayland setup fail, and older labwc versions then refuse to start.
#   WSLg's sockets are mounted into the fresh directory, so that the compositors' own
#   Xwayland servers see those display numbers as taken. Otherwise one of them becomes :0,
#   and the viewer, which reaches X through a socket name shared by all of WSL, would open
#   its window inside the session instead of on the Windows desktop.
mkdir -p /tmp/.X11-unix /run/hyprland-wsl/x11
unshare -m --propagation private sh -c '
    mount --bind "$1" "$2" || exit 1
    mount --bind /tmp/.X11-unix /run/hyprland-wsl/x11 || exit 1
    mount -t tmpfs -o mode=1777 tmpfs /tmp/.X11-unix || exit 1
    for s in /run/hyprland-wsl/x11/X*; do
        [ -S "$s" ] || continue
        touch "/tmp/.X11-unix/${s##*/}" && mount --bind "$s" "/tmp/.X11-unix/${s##*/}"
    done
    touch /tmp/.X11-unix/.hyprland-wsl && exec sleep infinity
' sh "$AQ_LIB/${SYS_LIB##*/}" "$SYS_LIB" &
NS=$!
wait_for nsenter -t $NS -m test -e /tmp/.X11-unix/.hyprland-wsl || die "could not set up the mount namespace"

# Mesa's software renderer starts one thread per CPU core. Under WSL that costs far more
# CPU than it gains (measured: over ten times the CPU for the same frames on 24 cores), so
# the number is capped. HYPRLAND_WSL_THREADS overrides it.
THREADS=${HYPRLAND_WSL_THREADS:-4}

as() { nsenter -t $NS -m --wd="$H" sudo -u "$U" env -u WAYLAND_DISPLAY -u DISPLAY XDG_RUNTIME_DIR="$R" HOME="$H" LANG="$LANG" LP_NUM_THREADS="$THREADS" "$@"; }

cd "$H" || exit 1

# Host compositor: no decorations, Hyprland's window fills the screen.
as mkdir -p "$H/.config/hyprland-wsl/labwc"
as tee "$H/.config/hyprland-wsl/labwc/rc.xml" > /dev/null <<'EOF'
<?xml version="1.0"?>
<labwc_config>
  <core><decoration>client</decoration></core>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no"><action name="Maximize"/></windowRule>
  </windowRules>
</labwc_config>
EOF

as WLR_BACKENDS=headless WLR_RENDERER=gles2 WLR_RENDERER_ALLOW_SOFTWARE=1 WLR_LIBINPUT_NO_DEVICES=1 \
    labwc -C "$H/.config/hyprland-wsl/labwc" > $LOG/labwc.log 2>&1 &
wait_for test -S "$R/wayland-0" || die "host compositor did not start, see $LOG/labwc.log"
as WAYLAND_DISPLAY=wayland-0 wlr-randr --output HEADLESS-1 --custom-mode "$RES" > /dev/null 2>&1

as WAYLAND_DISPLAY=wayland-0 Hyprland > $LOG/hyprland.log 2>&1 &
HYPR=$!
wait_for test -S "$R/wayland-1" || die "Hyprland did not start, see $LOG/hyprland.log"

if [ -n "$SCALE" ]; then
    # Hyprland with a Lua config takes this through "eval", older versions through "keyword".
    sig=$(ls "$R/hypr" | head -n 1)
    wait_for test -S "$R/hypr/$sig/.socket.sock"
    hc() { as HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl "$@"; }
    if [ -f "$H/.config/hypr/hyprland.lua" ]; then
        hc eval "hl.monitor({ output = \"WAYLAND-1\", mode = \"$RES@60\", position = \"0x0\", scale = $SCALE })"
    else
        hc keyword monitor "WAYLAND-1,$RES@60,0x0,$SCALE"
    fi > $LOG/scale.log 2>&1
    grep -q '^ok' $LOG/scale.log || echo "hyprland-wsl: could not set the scale, see $LOG/scale.log" >&2
fi

# wayvnc attaches to Hyprland itself, not to the host. Keys then reach Hyprland without
# passing the host's own key bindings (Alt+Tab, Alt+F4, Super+Return and so on), and the
# host is not made to render for a second observer.
as WAYLAND_DISPLAY=wayland-1 wayvnc 127.0.0.1 "$PORT" > $LOG/wayvnc.log 2>&1 &
wait_for test -S "$R/wayvncctl" || die "wayvnc did not start, see $LOG/wayvnc.log"
echo "Hyprland is running at $RES (VNC on 127.0.0.1:$PORT)."

if [ $VIEWER = 1 ]; then
    # WSLg's X server shows this as an ordinary window on the Windows desktop.
    [ -S /tmp/.X11-unix/X0 ] || die "WSLg display not found; use --no-viewer and connect a VNC client to 127.0.0.1:$PORT"
    [ -n "$VNCVIEWER" ] || die "no TigerVNC viewer found; use --no-viewer"
    sudo -u "$U" env DISPLAY=:0 HOME="$H" "$VNCVIEWER" -RemoteResize=0 "127.0.0.1::$PORT" > $LOG/viewer.log 2>&1
else
    wait $HYPR
fi

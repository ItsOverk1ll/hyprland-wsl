-            waylandState.xdg = makeShared<CCXdgWmBase>((wl_proxy*)wl_registry_bind((wl_registry*)waylandState.registry->resource(), id, &xdg_wm_base_interface, 6));
+            waylandState.xdg = makeShared<CCXdgWmBase>((wl_proxy*)wl_registry_bind((wl_registry*)waylandState.registry->resource(), id, &xdg_wm_base_interface, std::min(version, 6u)));
             initShell();
         } else if (NAME == "wl_compositor") {
             TRACE(backend->log(AQ_LOG_TRACE, std::format("  > binding to global: {} (version {}) with id {}", name, 6, id)));
-            waylandState.compositor = makeShared<CCWlCompositor>((wl_proxy*)wl_registry_bind((wl_registry*)waylandState.registry->resource(), id, &wl_compositor_interface, 6));
+            waylandState.compositor = makeShared<CCWlCompositor>((wl_proxy*)wl_registry_bind((wl_registry*)waylandState.registry->resource(), id, &wl_compositor_interface, std::min(version, 6u)));
         } else if (NAME == "wl_shm") {
             TRACE(backend->log(AQ_LOG_TRACE, std::format("  > binding to global: {} (version {}) with id {}", name, 1, id)));
             waylandState.shm = makeShared<CCWlShm>((wl_proxy*)wl_registry_bind((wl_registry*)waylandState.registry->resource(), id, &wl_shm_interface, 1));
@@ -183,6 +183,9 @@
     if (backend->ready)
         o->swapchain = CSwapchain::create(backend->primaryAllocator, self.lock());
     idleCallbacks.emplace_back([this, o]() { backend->events.newOutput.emit(SP<IOutput>(o)); });
+    // WSL patch: send the output's initial commit now. Otherwise it waits for the host to send
+    // something first, and a headless host with no input devices never does.
+    wl_display_flush(waylandState.display);
     return true;
 }
 
@@ -523,9 +526,27 @@
         return;
     }
 
-    waylandState.xdgSurface->setConfigure([this](CCXdgSurface* r, uint32_t serial) {
+    // WSL patch: the toplevel size is only applied after the xdg_surface configure has been acked.
+    // Emitting state from the toplevel handler makes the consumer commit a buffer before the ack,
+    // which wlroots hosts reject with "xdg_surface has never been configured".
+    auto pendingSize = makeShared<std::optional<Hyprutils::Math::Vector2D>>();
+
+    waylandState.xdgSurface->setConfigure([this, pendingSize](CCXdgSurface* r, uint32_t serial) {
         backend->backend->log(AQ_LOG_DEBUG, std::format("Output {}: configure surface with {}", name, serial));
         r->sendAckConfigure(serial);
+        if (!pendingSize->has_value())
+            return;
+        const auto SIZE = pendingSize->value();
+        pendingSize->reset();
+        // Queued behind the newOutput callback so the consumer knows the output before its size.
+        backend->idleCallbacks.emplace_back([o = self, SIZE]() {
+            auto out = o.lock();
+            if (!out)
+                return;
+            out->events.state.emit(SStateEvent{.size = SIZE});
+            out->needsFrame = true;
+            out->sched.frameReady.emit();
+        });
     });
 
     waylandState.xdgToplevel = makeShared<CCXdgToplevel>(waylandState.xdgSurface->sendGetToplevel());

+    wl_display_flush(waylandState.display);
     return true;
 }
 
@@ -177,10 +180,18 @@
 
     // dispatch frames
     if (backend->ready) {
-        for (auto const& f : idleCallbacks) {
-            f();
+        // WSL patch: callbacks can queue more callbacks, which must not happen to the list
+        // being walked. Those are run too (a few rounds at most) and what they send is
+        // flushed right away, because under a headless host there may be no further event
+        // to trigger the next dispatch.
+        for (int round = 0; round < 8 && !idleCallbacks.empty(); ++round) {
+            const auto callbacks = std::move(idleCallbacks);
+            idleCallbacks.clear();
+            for (auto const& f : callbacks) {
+                f();
+            }
         }
-        idleCallbacks.clear();
+        wl_display_flush(waylandState.display);
     }
 
     return true;
